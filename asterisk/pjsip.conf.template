; -----------------------------------------------------------------------------
;  PJSIP 設定テンプレート
;  コンテナ起動時に envsubst で ${LAN_IP} を .env の値に置き換え、
;  /etc/asterisk/pjsip.conf を生成する（compose.yaml の entrypoint 参照）。
; -----------------------------------------------------------------------------

; 共通トランスポート設定
; Zoiper の設定を call/ と共用するため、SIP ポートは call と同じ 5070 にしている
[transport-udp]
type=transport
protocol=udp
bind=0.0.0.0:5070
; Docker 越しでも SDP / Contact に Mac の LAN IP を載せる（載せないと無音になる）
external_media_address=${LAN_IP}
external_signaling_address=${LAN_IP}

; テンプレート
[endpoint-template](!)
type=endpoint
context=from-internal
disallow=all
allow=ulaw
allow=alaw
direct_media=no
force_rport=yes
rewrite_contact=yes
rtp_symmetric=yes

[aor-template](!)
type=aor
max_contacts=1
; call と行き来すると古い登録が残るので、新しい登録で上書きする
remove_existing=yes

; --- 内線 6001 (Mac の Zoiper) ---
[6001](endpoint-template)
auth=6001
aors=6001

[6001](aor-template)

; --- 内線 6002 (スマホの Zoiper) ---
[6002](endpoint-template)
auth=6002
aors=6002

[6002](aor-template)

; パスワード (type=auth) は git に入れない別ファイルに置く
#include pjsip_auth.conf
