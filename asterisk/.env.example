# cp .env.example .env して、自分の環境の値に書き換える

# Asterisk を動かしている Mac の LAN IP。Zoiper はこの IP に接続し、
# Asterisk は SDP にこの IP を載せて「音声はここへ送って」と伝える。
# 調べ方: ipconfig getifaddr en0
LAN_IP=192.168.1.23

# SIP（呼制御）のポート。標準は 5060。5060 以外にしたら Zoiper のサーバ欄に
# 「LAN_IP:SIP_PORT」とポートも書く。
SIP_PORT=5060

# RTP（音声）のポート範囲。1 通話で 2 ポート使う。
# 同じ Mac で他の Asterisk 等とぶつかるときだけ変える。
RTP_PORT_START=10000
RTP_PORT_END=10020
